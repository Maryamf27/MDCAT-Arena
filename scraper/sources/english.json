      "unit_number": 2,
      "unit_title": "FORMAL AND LEXICAL ASPECT OF LANGUAGE",
      "topics": [
        {
          "topic_name": "Formal and Lexical Aspect of Language",
          "slos": [
            {
              "id": "2.1",
              "text": "Deduce the meaning of difficult words from the context using contextual clues."
            },
            {
              "id": "2.2",
              "text": "Explore the use of Synonyms with varying shades of meaning used for irony, parody and satire."
            },
            {
              "id": "2.3",
              "text": "Illustrate use of pronoun-antecedent agreement."
            },
            {
              "id": "2.4",
              "text": "Illustrate use of tenses."
            },
            {
              "id": "2.5",
              "text": "Illustrate use of infinitives and infinitives phrases."
            },
            {
              "id": "2.6",
              "text": "Illustrate the use of gerund and gerund phrases."
            },
            {
              "id": "2.7",
              "text": "Recognize varying position of adverbs in sentences according to their kinds and importance."
            },
            {
              "id": "2.8",
              "text": "Illustrate use of prepositions of position, time, movements and directions."
            },
            {
              "id": "2.9",
              "text": "Use in speech and writing, all the appropriate transitional devices."
            },
            {
              "id": "2.10",
              "text": "Illustrate use of all punctuation marks wherever applicable"
            },
            {
              "id": "2.11",
              "text": "Analyze sentences for different classes and phrases, evaluate how their position in sentences when change meaning and different communication function."
            },
            {
              "id": "2.12",
              "text": "Recognize and use sentence in version for various purposes."
            },
            {
              "id": "2.13",
              "text": "Use active and passive voice appropriately in speech and writing according to the required communicative function"
            },
            {
              "id": "2.14",
              "text": "Use direct and indirect speech appropriately in speech and writing according to the e required communicative function."
            }
